{
  "manifest_version": 3,
  "name": "Is It AI Slop?",
  "version": "1.1.0",
  "description": "Minimalist browser extension to detect AI-generated slop and low-quality boilerplate text on websites using TypeSafe AI JEV, ONNX, and heuristics.",

  "browser_specific_settings": {
    "gecko": {
      "id": "is-it-ai-slop@extension",
      "strict_min_version": "109.0"
    }
  },

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "host_permissions": [
    "https://api.typesafe.ai/*"
  ],

  "background": {
    "scripts": [
      "lib/onnxruntime/ort.min.js",
      "scripts/background.js"
    ],
    "service_worker": "scripts/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Is It AI Slop? - Scan Page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "env.js",
        "scripts/extractor.js",
        "scripts/analyzer.js",
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "env.js",
        "lib/onnxruntime/ort.min.js",
        "lib/onnxruntime/ort-wasm.wasm",
        "lib/onnxruntime/ort-wasm-simd.wasm",
        "models/ai-slop_model.onnx"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
