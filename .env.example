# OpenRouter configuration (JEV model)
# The API key is NOT read from here: enter it in the extension popup (gear icon).
# Get a key at https://openrouter.ai/keys

# OpenRouter chat completions endpoint
JEV_API_URL=https://openrouter.ai/api/v1/chat/completions

# Text chunking threshold: Maximum words per single API call to JEV
# Texts longer than this will be split at periods (.) or paragraph breaks
JEV_MAX_WORDS_PER_CALL=200
