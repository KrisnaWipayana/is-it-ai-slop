# TypeSafe AI JEV API Configuration
# Get your API key from https://typesafe.ai
TYPESAFE_API_KEY=your_typesafe_api_key_here

# TypeSafe AI System One Endpoint
JEV_API_URL=https://api.typesafe.ai/v1/systemone

# Model identifier (e.g. jev-latest, jev-1.14.0)
JEV_MODEL=jev-latest

# Text chunking threshold: Maximum words per single API call to JEV
# Texts longer than this will be split at periods (.) or paragraph breaks
JEV_MAX_WORDS_PER_CALL=150
